# Google AI Studio API Key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Embedding & Chat Models (per google-ai-studio-rag skill)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# ==============================================================================
# LIVE GOOGLE DOCS (.docx) & EXCEL / GOOGLE SHEETS (.xlsx) RAG SOURCES
# ==============================================================================
# Option 1 (Simple): Share each document as "Anyone with the link -> Viewer"
# and paste either the full Google Docs/Sheets URL or just the Document ID:
GOOGLE_PRICE_DOC_URL=
GOOGLE_FAQ_DOC_URL=
GOOGLE_SCHEDULE_XLSX_URL=
GOOGLE_BOOKINGS_SHEET_URL=

# Cache TTL in milliseconds (default 5000 = 5 sec; set 0 to always fetch on every message)
RAG_CACHE_TTL_MS=5000

# Option 2 (Private Docs via Google Cloud Console Service Account):
# Only needed if documents are NOT shared publicly by link.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
